generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enum sirve para restringir los estados de avance a opciones fijas
enum EstadoJuego {
  PENDIENTE
  JUGANDO
  COMPLETADO
  ABANDONADO
}

// Modelo relacional para la tabla de la biblioteca de videojuegos
model JuegoUsuario {
  id            String      @id @default(uuid())
  idUsuario     String      // ID del usuario propietario
  tituloJuego   String      // Nombre del videojuego
  urlPortada    String?     // URL de la imagen de portada (el ? significa opcional)
  estado        EstadoJuego @default(PENDIENTE)
  creadoEn      DateTime    @default(now())
  actualizadoEn DateTime    @updatedAt

  // Restricción única: Un mismo usuario no puede registrar dos veces el mismo juego
  @@unique([idUsuario, tituloJuego])
}
