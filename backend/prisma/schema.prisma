// Configuraciones para conexión con PostgreSQL
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// Modelo para la tabla de usuarios
model Usuario {
  id                   String         @id @default(uuid())
  nombre               String
  username             String         @unique
  email                String         @unique
  password             String
  avatar               String?
  biografia            String         @default("")
  creadoEn             DateTime       @default(now())
  actualizadoEn        DateTime       @updatedAt
  juegos               JuegoUsuario[]
  solicitudesEnviadas  Amistad[]      @relation("SolicitudesEnviadas")
  solicitudesRecibidas Amistad[]      @relation("SolicitudesRecibidas")
}

// Enum sirve para restringir los estados de avance a opciones fijas
enum EstadoJuego {
  PENDIENTE
  JUGANDO
  COMPLETADO
  ABANDONADO
}

// Enum para estado de las relaciones de amistad
enum EstadoAmistad {
  PENDIENTE
  ACEPTADA
  RECHAZADA
}

// Modelo maestro para el catálogo centralizado de videojuegos
model Juego {
  id                   String         @id @default(uuid())
  externalId           String?        @unique
  slug                 String?
  titulo               String
  descripcion          String         @default("")
  urlPortada           String?
  plataformas          String         @default("")
  sistemas             String         @default("")
  generos              String         @default("")
  tematicas            String         @default("")
  metacritic           Int?
  igdbRating           Int?
  jugadores            String?
  requiereInternet     Boolean?
  metaEnriquecida      Boolean        @default(false)
  desarrollador        String         @default("")
  editor               String         @default("")
  anoLanzamiento       Int?
  enlacesTienda        String         @default("{}")

  // Santuario — identidad visual
  logoUrl              String?
  bannerUrl            String?

  // Santuario — tiempos (HowLongToBeat)
  hltbMain             Float?
  hltbCompletionist    Float?

  // Santuario — preservación
  manualUrl            String?
  archiveIdentifier    String?

  // Santuario — crítica (OpenCritic)
  openCriticScore      Int?
  openCriticRecommend  Int?
  openCriticTier       String?

  // Santuario — multimedia
  trailerYoutubeId     String?
  screenshotsJson      String         @default("[]")
  specsJson            String         @default("{}")

  // Orquestación de enriquecimiento
  santuarioEnriquecido Boolean        @default(false)
  enriquecidoEn        DateTime?

  creadoEn             DateTime       @default(now())
  actualizadoEn        DateTime       @updatedAt
  usuarios             JuegoUsuario[]
}

// Modelo relacional para la tabla de la biblioteca de videojuegos
model JuegoUsuario {
  id            String      @id @default(uuid())
  idUsuario     String
  idJuego       String?
  tituloJuego   String
  urlPortada    String?
  descripcion   String      @default("")
  plataformas   String      @default("")
  sistemas      String      @default("")
  generos       String      @default("")
  tematicas     String      @default("")
  metacritic    Int?
  desarrollador String      @default("")
  etiquetas     String      @default("")
  comentario    String      @default("")
  /// JSON: documentos de preservación añadidos por el usuario [{id,tipo,titulo,url}]
  preservacionUsuarioJson String @default("[]")
  calificacion  Int?
  estado        EstadoJuego @default(PENDIENTE)
  creadoEn      DateTime    @default(now())
  actualizadoEn DateTime    @updatedAt

  usuario       Usuario     @relation(fields: [idUsuario], references: [id], onDelete: Cascade)
  juego         Juego?      @relation(fields: [idJuego], references: [id], onDelete: SetNull)

  @@unique([idUsuario, tituloJuego])
}

// Modelo relacional para sistema de amigos
model Amistad {
  id            String        @id @default(uuid())
  idSolicitante String
  idReceptor    String
  estado        EstadoAmistad @default(PENDIENTE)
  creadoEn      DateTime      @default(now())
  actualizadoEn DateTime      @updatedAt

  solicitante   Usuario       @relation("SolicitudesEnviadas", fields: [idSolicitante], references: [id], onDelete: Cascade)
  receptor      Usuario       @relation("SolicitudesRecibidas", fields: [idReceptor], references: [id], onDelete: Cascade)

  @@unique([idSolicitante, idReceptor])
}