DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gametracker?schema=public"
JWT_SECRET="cambia-esta-clave"

# IGDB (cuenta Twitch del proyecto) — no subir valores reales a git
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Alias opcionales (mismo valor que TWITCH_*)
# IGDB_CLIENT_ID=
# IGDB_CLIENT_SECRET=

# Otras APIs opcionales
# RAWG_API_KEY=
# YOUTUBE_API_KEY=   # última opción de tráilers si IGDB no aporta vídeo
# STEAMGRIDDB_API_KEY=  # opcional; sin key se usa logo oficial Steam CDN
# OPENCRITIC_API_KEY=   # RapidAPI (opencritic-api) — opcional; sin key se usa Wikidata/Wikipedia + scrape
