# Dependencias de Node (evita subir carpetas gigantescas)
node_modules/
**/node_modules/

# Archivos de variables de entorno (contraseñas, secretos JWT, URLs de BD)
.env
.env.local
.env.*.local
**/.env

# Carpetas de compilación / producción
dist/
build/
**/dist/
**/build/

# Herramientas locales embebidas (Node, Postgres de desarrollo)
backend/.tools/
**/.tools/

# Cliente Prisma generado localmente
backend/generated/
**/generated/

# Datos locales de Postgres embebido
**/pgdata/

# Archivos de registro y caché
*.log
*.log.err
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.DS_Store

# Caché de editores de código
.vscode/
.idea/
